#!/bin/bash
# 밀기 직전, 원격에 없는 커밋 전부를 본다. stdin: <local ref> <local sha> <remote ref> <remote sha>
set -e
ROOT=$(git rev-parse --show-toplevel); CHECK="$ROOT/pipeline/check_private.py"
IMPORTS="$ROOT/pipeline/check_imports.py"
ZERO=0000000000000000000000000000000000000000
ran=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue                     # 브랜치 삭제
  if [ "$remote_sha" = "$ZERO" ]; then range="$local_sha"    # 원격에 없던 브랜치
  else range="$remote_sha..$local_sha"; fi
  python3 "$CHECK" --range "$range" || exit 3
  # **클론이 컴파일되는가.** pre-commit 은 스테이지에 올라간 것만 본다 —
  # `Root.tsx` 가 무시되는 편 폴더를 부르는 채로 트리에 있었는데 한 번도 스테이지에
  # 안 올라가서 아무도 안 울었다. 미는 범위는 여기서 다시 본다.
  python3 "$IMPORTS" --range "$range" || exit 3
  ran=1
done
[ "$ran" = 1 ] || python3 "$CHECK"                           # 밀 것이 없으면 추적 파일만이라도 본다
